{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-format.sh",
            "timeout": 120,
            "statusMessage": "Formatting Go code..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-lint-stop.sh",
            "timeout": 120,
            "statusMessage": "Verifying lint passes..."
          },
          {
            "type": "command",
            "command": "go fix ./...",
            "timeout": 120,
            "statusMessage": "Using go fix to modernize Go code..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "'.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh'",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "'.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
